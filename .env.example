# Copy this file to .env and replace with the bot token from your Discord Developer Portal.
DISCORD_BOT_TOKEN=replace-with-your-bot-token

# Required for an internet-facing deployment. Use a long, unique password.
DASHBOARD_PASSWORD=replace-with-a-long-unique-password

# Optional session signing key. If omitted, RakWebDrop uses its private generated secret.
SESSION_SECRET=replace-with-a-random-secret

# For a persistent volume mounted at /data on the hosting service.
DATA_DIR=/data
